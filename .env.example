# كوبي هذا الملف لـ `.env` وعمّرو بالقيم الحقيقية (للتجريب المحلي بـ `npx netlify dev`).
# في الإنتاج، حطّ هاذو في Netlify: Site settings → Environment variables.
# ⚠️ `.env` ما يدخلش لـ git — شوف `.gitignore`.

# ── ضروري: إشعار الطلب على تيليغرام ──────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
TELEGRAM_CHAT_ID=-1001234567890

# كلمة سرّ تخترعها انت، ونفسها تعطيها لـ setWebhook باش أزرار
# قبول/رفض تخدم. شوف README قسم "تشبيك الأزرار".
TELEGRAM_WEBHOOK_SECRET=

# ── اختياري: SMS تأكيد للزبون عبر Twilio ─────────────────────────
# بلاهم، الطلب يخدم عادي والزبون ما يوصلوش SMS.
# ⚠️ حساب Twilio Trial يبعث غير للأرقام المتحقّق منها.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
